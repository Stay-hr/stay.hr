# Cloudflare DNS: see scripts/.env.example and ./scripts/cloudflare_dns_upsert.sh
# Hosts: api.stay.hr, admin.stay.hr, *.stay.hr (proxied A → Traefik → django)
# CF_DNS_API_TOKEN must be a valid Zone DNS Edit token — same value as
# /opt/stacks/traefik/.env (Traefik ACME DNS-01 + Django Provision DNS).
CF_DNS_API_TOKEN=
STAY_SERVER_IP=
CLOUDFLARE_ZONE_STAY=stay.hr
STAY_API_INTERNAL_URL=http://stay-django:8000
STAY_PUBLIC_API_URL=https://api.stay.hr
# Public booking web BFF — ApiApplication with public:read + reservations:create
STAY_BOOKING_API_TOKEN=

# Django
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.stay.hr,admin.stay.hr,*.stay.hr,app.stay.hr,stay-django,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.stay.hr,https://admin.stay.hr,https://app.stay.hr,https://*.stay.hr

# Gunicorn (django container — see scripts/run-gunicorn.sh)
GUNICORN_WORKERS=12
GUNICORN_WORKER_CLASS=sync
# Long timeout because Reception SSE connections are intentionally long-lived.
# This is NOT a normal HTTP request timeout.
GUNICORN_TIMEOUT=3600
GUNICORN_KEEPALIVE=5
GUNICORN_GRACEFUL_TIMEOUT=60
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_PRELOAD=false

# Reservation version SSE evolution (ADR 0005)
# Phase 2a: RESERVATION_VERSION_EVENT_BUS=in_process|redis
#   Default: in_process. Enable redis after lifecycle instrumentation is healthy.
#   Rollback: set in_process, then docker compose up -d django celery-worker
# Phase 2b: SSE_TRANSPORT=gunicorn|uvicorn (not implemented yet)

# Deploy traceability (optional — set at build via Dockerfile ARG or runtime)
# STAY_GIT_SHA=abc1234

# Database (shared PostGIS — /opt/stacks/data, container: postgis, network: postgis)
DB_HOST=postgis
DB_PORT=5432
DB_NAME=stay_platform_db
DB_USER=stay
DB_PASSWORD=change-me
DB_CONN_MAX_AGE=60

# Uzorita legacy read-only source (migrate_uzorita_legacy / validate_uzorita_migration)
# UZORITA_DB_NAME=uzorita_db
# UZORITA_DB_USER=postgres
# UZORITA_DB_PASSWORD=
# UZORITA_DB_HOST=localhost
# UZORITA_DB_PORT=5432
# UZORITA_EVISITOR_ENABLED=true
# UZORITA_EVISITOR_ENV=test
# UZORITA_EVISITOR_BASE_URL=https://www.evisitor.hr/testApi
# UZORITA_EVISITOR_USERNAME=
# UZORITA_EVISITOR_PASSWORD=
# UZORITA_EVISITOR_API_KEY=
# UZORITA_EVISITOR_FACILITY_CODE=

# Demo eVisitor bootstrap (seed_evisitor_config — test HTZ okolina)
# DEMO_EVISITOR_USERNAME=
# DEMO_EVISITOR_PASSWORD=
# DEMO_EVISITOR_API_KEY=
# DEMO_EVISITOR_FACILITY_CODE=
# DEMO_EVISITOR_BASE_URL=https://www.evisitor.hr/testApi
# DEMO_EVISITOR_ENV=test
# DEMO_EVISITOR_ENABLED=true

# Channex — per-tenant credentials live in Django admin (Integration configs), not .env.
# Bootstrap only (optional one-shot seed): export CHANNEX_* then run sync_channex_credentials --tenant-slug uzorita
# CHANNEX_PROPERTY_ID=
# CHANNEX_API_KEY=
# CHANNEX_WEBHOOK_SECRET=
# See docs/operations/channex-credentials-migration.md

# Unit listing photos (ADR 0015) — validation before UnitPhoto insert
# UNIT_PHOTO_MAX_BYTES=8388608
# UNIT_PHOTO_MAX_EDGE=8000
# UNIT_PHOTO_MIN_EDGE=100
# UNIT_PHOTO_VERIFY_AFTER_UPLOAD=true  # GET photo after create (hel1 rollout)

# Channex outbound (ADR 0014) — FAIL-CLOSED default in code (False).
# hel1 MUST set true before deploy or production becomes read-only:
#   CHANNEX_OUTBOUND_ENABLED=true
# WSL / local: false (also forced in docker-compose.dev.yml).
#   Non-GET Channex API calls are blocked; write Beat tasks return skipped.
#   Verify-only (availability verify daily) still runs on read-only hosts.
#   READ (webhooks, availability GET, photo LIST/GET) is always allowed.
CHANNEX_OUTBOUND_ENABLED=false
# CHANNEX_OUTBOUND_ENABLED=true   # hel1 writer only
# CHANNEX_OUTBOUND_TENANT_SLUGS=uzorita  # optional allowlist when enabled
# CHANNEX_OUTBOUND_MAINTENANCE=false
# CHANNEX_ARI_REPAIR_MAX_UNITS=5
# CHANNEX_ARI_REPAIR_MAX_UNIT_PERCENT=20
# CHANNEX_ARI_REPAIR_MAX_DAYS_PER_UNIT=3

# ChannelSyncObserver (ADR 0015 Layer 2/3) — stay.hr ↔ Channex photo verify on /system/status
# CHANNEL_PHOTO_STATUS_ENABLED=true

# Smoobu — removed from stay.hr (migration 0017). Uzorita uses Channex. Do not put in .env.

# Meta / WhatsApp Cloud API — app stay.hr (Facebook Login NOT required)
# META_APP_ID=                    # Settings → Basic → App ID (reference only)
# META_APP_CONTACT_EMAIL=info@stay.hr
# META_PRIVACY_POLICY_URL=https://finestar.hr/privacy
# META_TERMS_URL=https://stay.hr/terms
# WHATSAPP_APP_SECRET=            # Settings → Basic → App secret (Show)
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=  # random string; same in Meta webhook config
# WHATSAPP_API_VERSION=v23.0
# WHATSAPP_ACCESS_TOKEN=          # System User token (Meta Graph API) — never commit
# WHATSAPP_WABA_ID=               # optional; fallback for template sync/create CLI
# Webhook callback: https://api.stay.hr/api/v1/integrations/whatsapp/webhook/
# Integration identity (phone_number_id, display_phone_number, waba_id) in Django admin → Integration configs.
# Platform default number: docker compose exec django python manage.py seed_platform_whatsapp_config
# Hotel tenant number: docker compose exec django python manage.py seed_uzorita_whatsapp_config

# Fernet key: IntegrationConfig (eVisitor) + encrypted API device tokens in admin
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# STAY_INTEGRATION_FERNET_KEY=

# Firebase FCM (Admin SDK service account — mount in docker-compose, never commit JSON)
# FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json
# FIREBASE_PROJECT_ID=hospira-fc0dc

# FCM push guard (fail-closed: prazna lista = nema slanja)
FCM_PUSH_ENABLED=true
# Temporary: set true during deploy/import/seed; revert to false after
FCM_PUSH_MAINTENANCE=false
# Temporary: blocks guest auto check-in (document intake, welcome template); revert after deploy
WHATSAPP_AUTOCHECKIN_MAINTENANCE=false
# Document intake lifecycle gate (checked_out/canceled/no_show/refused); false = legacy behaviour
WHATSAPP_DOCUMENT_INTAKE_LIFECYCLE_GATE=true
# Guest document intake: web check-in only (WhatsApp sends link, no guest WA OCR)
GUEST_CHECKIN_WEB_ONLY=true
# OCR address normalizer (FR postal street-first → City, street); false = rollback
OCR_ADDRESS_NORMALIZATION_ENABLED=true
# Legacy pre-arrival reminder days (comma). Use 7 only until Messaging Engine LIVE+suppress
# owns D0 — avoids midnight WhatsApp from days_before=0 (ADR 0010 §11 quiet hours).
GUEST_CHECKIN_REMINDER_ENABLED=true
GUEST_CHECKIN_REMINDER_DAYS_BEFORE=7
# Days to wait for a usable invoice email after asking the guest (OTA relay capture)
INVOICE_EMAIL_WAITING_TIMEOUT_DAYS=14
# Property Settings on app.stay.hr/settings (ADR 0008). false = hide nav + all capabilities off.
RECEPTION_PROPERTY_SETTINGS=true
FCM_PUSH_ALLOWED_TENANT_SLUGS=demo,uzorita,channex

# Messaging Orchestration Engine (ADR 0010) — rollout flags.
# Fail-closed: ENABLED=true with empty TENANTS and PROPERTIES → no materialize/send.
# SHADOW=true → Celery materializes planned MessageDispatch rows only (no provider send).
# SHADOW=false + allowlist → live dispatch; Phase 7 suppresses legacy for that scope.
# Health inventory: GET /api/v1/reception/system/status/ → messaging block (definitions,
# templates, providers, plans, outbox planned/queued depth, last success/failure).
MESSAGE_ORCHESTRATION_ENABLED=false
MESSAGE_ORCHESTRATION_SHADOW=true
MESSAGE_ORCHESTRATION_TENANTS=uzorita
MESSAGE_ORCHESTRATION_PROPERTIES=
# Ops alerts when all channel_policy providers fail (comma-separated).
OPERATIONS_ALERT_EMAILS=avrcanus@gmail.com
# Throttle window for identical all-providers-failed alerts (seconds).
MESSAGING_ALERT_THROTTLE_SECONDS=300

# Outbound email (guest booking confirmation / refusal)
# Per-tenant SMTP credentials are configured in Django admin:
# Tenants → Reception settings → guest_contact_email + Guest SMTP password.
# Host is derived automatically as mail.{domain from email} (port 587, TLS).
# Optional global fallback if tenant SMTP is not set:
# EMAIL_HOST=mail.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@stay.hr
# Tenant guest/offer email (room_reservations@tenant.hr) authenticates against:
# STAY_TENANT_SMTP_HOST=mail.stay.hr
#
# Ops reports (document intake OCR quality email via Celery):
# EMAIL_HOST=mail.finestar.hr
# EMAIL_HOST_USER=reports@stay.hr
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=reports@stay.hr
# DOCUMENT_INTAKE_QUALITY_REPORT_ENABLED=true
# DOCUMENT_INTAKE_QUALITY_REPORT_EMAIL=ops@example.com
# DOCUMENT_INTAKE_QUALITY_REPORT_DAYS=1          # KPI lookback window (days)
# DOCUMENT_INTAKE_QUALITY_REPORT_SEND_EVERY_DAYS=1 # minimum days between emails
# DOCUMENT_INTAKE_QUALITY_REPORT_MONDAY_ONLY=false
# DOCUMENT_INTAKE_REPORT_SNAPSHOT_PATH=          # default: {MEDIA_ROOT}/ops/document_intake_report_snapshot.json
# DAYS and SEND_EVERY_DAYS are independent — e.g. DAYS=7 with SEND_EVERY_DAYS=1 sends daily mail over a 7-day window.

# Daily ops report (Celery email at 10:00 Europe/Zagreb)
# DAILY_OPS_REPORT_ENABLED=true
# DAILY_OPS_REPORT_EMAILS=ops@example.com
# DAILY_OPS_REPORT_KEEP_DAYS=90
# DAILY_OPS_REPORT_TENANT_ID=2
# DAILY_OPS_REPORT_DB_SAMPLES=50
# DAILY_OPS_REPORT_DISK_WARN_PCT=85
# DAILY_OPS_REPORT_DISK_CRIT_PCT=95
# DAILY_OPS_REPORT_CELERY_EXPECTED=celery-worker,celery-beat
# Optional host cron (Experimental): ./scripts/collect-docker-gunicorn-signals.sh
# SSE lifecycle observation (optional daily ~09:50 Zagreb): ./scripts/observe-sse-lifecycle-cron.sh
#   Permanent instrumentation health check — not a Phase 2a calendar gate (ADR 0005).
#   Needs RECEPTION_API_TOKEN (reception:read) — prefer /etc/stay/sse-observe.env
#   Optional: LOAD_TEST_RESERVATION_ID for --canary rise/fall checks
# RECEPTION_API_TOKEN=

# Property financial report (reception API) — max check_out period in days
# PROPERTY_FINANCIAL_REPORT_MAX_DAYS=90
# Monthly Celery email (1st of month 08:00 Zagreb) — requires SMTP + property financial_report_recipients
# PROPERTY_FINANCIAL_REPORT_EMAIL_ENABLED=false

# Guest message compose (LLM — Channex / Booking.com odgovori; reception POST .../messages/compose/)
# GUEST_COMPOSE_LLM_PROVIDER=openai
# GUEST_COMPOSE_LLM_API_KEY=sk-proj-...
# GUEST_COMPOSE_LLM_MODEL=gpt-4o-mini
# GUEST_COMPOSE_LLM_TIMEOUT_SEC=30
# GUEST_COMPOSE_PROMPT_VERSION=v1

# Document OCR (WhatsApp share / batch intake — OpenAI Vision)
# DOCUMENT_OCR_LLM_PROVIDER=openai
# DOCUMENT_OCR_LLM_API_KEY=sk-proj-...   # optional; falls back to GUEST_COMPOSE_LLM_API_KEY
# DOCUMENT_OCR_LLM_MODEL=gpt-4o
# DOCUMENT_OCR_LLM_TIMEOUT_SEC=90
# DOCUMENT_OCR_PROMPT_VERSION=v1

# Fiskal Platform v2 Execution API (guest invoice F1 — see docs/architecture)
# Token: fiskal-cli create-api-client --name stay --allowed-applications stay --allowed-providers pu_cis
FISKAL_PLATFORM_URL=http://fiskal-api:8000
FISKAL_PLATFORM_API_KEY=
FISKAL_EXECUTION_ENABLED=false
FISKAL_EXECUTION_POLL_INTERVAL=2
FISKAL_EXECUTION_POLL_TIMEOUT=120

# Redis / Celery (shared infra-redis — /opt/stacks/redis, DB 2)
REDIS_URL=redis://infra-redis:6379/2
CELERY_BROKER_URL=redis://infra-redis:6379/2
CELERY_RESULT_BACKEND=redis://infra-redis:6379/2
