<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stay.hr structural XSD for ObrazacPDVS aligned with ePorezna ObrazacPDVS-v1-0
  export shape. Isporuke children (Isporuka/…) are accepted via lax any so filled
  reference exports validate without inventing a private schema fork.
-->
<xs:schema
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:pdvs="http://e-porezna.porezna-uprava.hr/sheme/zahtjevi/ObrazacPDVS/v1-0"
  xmlns:meta="http://e-porezna.porezna-uprava.hr/sheme/Metapodaci/v2-0"
  targetNamespace="http://e-porezna.porezna-uprava.hr/sheme/zahtjevi/ObrazacPDVS/v1-0"
  elementFormDefault="qualified"
  attributeFormDefault="unqualified">

  <xs:import
    namespace="http://e-porezna.porezna-uprava.hr/sheme/Metapodaci/v2-0"
    schemaLocation="Metapodaci-v2-0.xsd"/>

  <xs:element name="ObrazacPDVS">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="meta:Metapodaci"/>
        <xs:element name="Zaglavlje" type="pdvs:ZaglavljeType"/>
        <xs:element name="Tijelo" type="pdvs:TijeloType"/>
      </xs:sequence>
      <xs:attribute name="verzijaSheme" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="ZaglavljeType">
    <xs:sequence>
      <xs:element name="Razdoblje" type="pdvs:RazdobljeType"/>
      <xs:element name="Obveznik" type="pdvs:ObveznikType"/>
      <xs:element name="ObracunSastavio" type="pdvs:ObracunSastavioType"/>
      <xs:element name="Ispostava" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="RazdobljeType">
    <xs:sequence>
      <xs:element name="DatumOd" type="xs:date"/>
      <xs:element name="DatumDo" type="xs:date"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ObveznikType">
    <xs:sequence>
      <xs:element name="Ime" type="xs:string"/>
      <xs:element name="Prezime" type="xs:string"/>
      <xs:element name="OIB" type="xs:string"/>
      <xs:element name="Adresa" type="pdvs:AdresaType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="AdresaType">
    <xs:sequence>
      <xs:element name="Mjesto" type="xs:string"/>
      <xs:element name="Ulica" type="xs:string"/>
      <xs:element name="Broj" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ObracunSastavioType">
    <xs:sequence>
      <xs:element name="Ime" type="xs:string"/>
      <xs:element name="Prezime" type="xs:string"/>
      <xs:element name="Email" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TijeloType">
    <xs:sequence>
      <xs:element name="Isporuke" type="pdvs:IsporukeType"/>
      <xs:element name="IsporukeUkupno" type="pdvs:IsporukeUkupnoType"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Filled exports use Isporuka children; lax any matches official flexibility. -->
  <xs:complexType name="IsporukeType">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="IsporukeUkupnoType">
    <xs:sequence>
      <xs:element name="I1" type="xs:string"/>
      <xs:element name="I2" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
