<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stay.hr structural XSD for ObrazacPDV aligned with ePorezna ObrazacPDV-v11-0
  export shape (PR1 zero Tijelo). Prefer replacing with the official schema later.
-->
<xs:schema
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:pdv="http://e-porezna.porezna-uprava.hr/sheme/zahtjevi/ObrazacPDV/v11-0"
  xmlns:meta="http://e-porezna.porezna-uprava.hr/sheme/Metapodaci/v2-0"
  targetNamespace="http://e-porezna.porezna-uprava.hr/sheme/zahtjevi/ObrazacPDV/v11-0"
  elementFormDefault="qualified"
  attributeFormDefault="unqualified">

  <xs:import
    namespace="http://e-porezna.porezna-uprava.hr/sheme/Metapodaci/v2-0"
    schemaLocation="Metapodaci-v2-0.xsd"/>

  <xs:element name="ObrazacPDV">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="meta:Metapodaci"/>
        <xs:element name="Zaglavlje" type="pdv:ZaglavljeType"/>
        <xs:element name="Tijelo" type="pdv:TijeloType"/>
      </xs:sequence>
      <xs:attribute name="verzijaSheme" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="ZaglavljeType">
    <xs:sequence>
      <xs:element name="Razdoblje" type="pdv:RazdobljeType"/>
      <xs:element name="Obveznik" type="pdv:ObveznikType"/>
      <xs:element name="ObracunSastavio" type="pdv:ObracunSastavioType"/>
      <xs:element name="Ispostava" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="RazdobljeType">
    <xs:sequence>
      <xs:element name="DatumOd" type="xs:date"/>
      <xs:element name="DatumDo" type="xs:date"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ObveznikType">
    <xs:sequence>
      <xs:element name="Ime" type="xs:string"/>
      <xs:element name="Prezime" type="xs:string"/>
      <xs:element name="OIB" type="xs:string"/>
      <xs:element name="Adresa" type="pdv:AdresaType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="AdresaType">
    <xs:sequence>
      <xs:element name="Mjesto" type="xs:string"/>
      <xs:element name="Ulica" type="xs:string"/>
      <xs:element name="Broj" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <!-- v11 ePorezna export: Ime + Prezime only (no Email). -->
  <xs:complexType name="ObracunSastavioType">
    <xs:sequence>
      <xs:element name="Ime" type="xs:string"/>
      <xs:element name="Prezime" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="VrijednostPorezType">
    <xs:sequence>
      <xs:element name="Vrijednost" type="xs:string"/>
      <xs:element name="Porez" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="NabavnaProdajnaType">
    <xs:sequence>
      <xs:element name="NabavnaVrijednost" type="xs:string"/>
      <xs:element name="ProdajnaVrijednost" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TijeloType">
